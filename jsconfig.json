{
  "compilerOptions": {
    "target": "es6",
    "module": "ES2022",
    "allowJs": true,
    "checkJs": true,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "node_modules/@types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
